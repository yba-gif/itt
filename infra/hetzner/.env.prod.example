# Copy this to .env and fill in all values before deploying.
# NEVER commit .env to git.

# --- Domain ---
DOMAIN=tgs-itt.ch
LETSENCRYPT_EMAIL=your@email.com

# --- Postgres ---
POSTGRES_USER=itt
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=itt
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://itt:CHANGE_ME_strong_password@postgres:5432/itt

# --- Backend ---
APP_ENV=production
APP_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_TTL_SECONDS=2592000
APPLE_BUNDLE_ID=ch.itt-rehber.app
APPLE_TEAM_ID=
SENTRY_DSN=
ADMIN_SEED_EMAIL=bek@itt-rehber.ch
ADMIN_SEED_PASSWORD=CHANGE_ME_admin_password

# Payment / invoice credentials (shown on every PDF invoice)
PAYEE_NAME=Roar (Yusuf Berkan Altun)
PAYEE_ADDRESS=Switzerland
TWINT_PHONE=+41 79 000 00 00
BANK_IBAN=CH00 0000 0000 0000 0000 0
BANK_NAME=Bank TBD

# --- Object storage ---
# Cloudflare R2: endpoint = https://<account_id>.r2.cloudflarestorage.com
# Leave blank to disable image uploads (other features still work)
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=itt-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# --- SMTP (leave blank = log-only, no emails sent) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM_EMAIL=noreply@tgs-itt.ch
SMTP_FROM_NAME=ITT-Rehber

# --- APNs (leave blank = push disabled) ---
APNS_KEY_ID=
APNS_KEY_P8_PATH=
APNS_TOPIC=ch.itt-rehber.app
APNS_USE_SANDBOX=false
