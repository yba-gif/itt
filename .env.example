# Postgres
# Inside Docker the container is reached at postgres:5432 (network alias).
# From the host (e.g., when running pytest natively) use localhost:5433 — port 5433
# avoids clashing with a host-level brew postgres listening on 5432.
POSTGRES_USER=itt
POSTGRES_PASSWORD=itt_dev
POSTGRES_DB=itt
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://itt:itt_dev@postgres:5432/itt

# Backend
APP_ENV=development
APP_SECRET=dev-secret-change-me-32-bytes-or-more-please
JWT_ALGORITHM=HS256
JWT_TTL_SECONDS=2592000
APPLE_BUNDLE_ID=ch.itt-rehber.app
APPLE_TEAM_ID=
SENTRY_DSN=
ADMIN_SEED_EMAIL=bek@itt-rehber.ch
ADMIN_SEED_PASSWORD=changeme
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# Object storage (S3 / R2 / MinIO)
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=eu-central-1
S3_BUCKET=itt-media
S3_ACCESS_KEY=ittminio
S3_SECRET_KEY=ittminio_dev
S3_PUBLIC_URL=http://localhost:9000/itt-media

# SMTP (empty = log-only fallback for dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=ITT-Rehber

# APNs (empty = log-only fallback for dev). Mount the .p8 into the container.
APNS_KEY_ID=
APNS_KEY_P8_PATH=
APNS_TOPIC=ch.itt-rehber.app
APNS_USE_SANDBOX=true

# Admin (Vite uses VITE_ prefix)
VITE_API_URL=http://localhost:8000

# Gemini AI proxy (keep this server-side, never in iOS bundle)
GEMINI_API_KEY=
